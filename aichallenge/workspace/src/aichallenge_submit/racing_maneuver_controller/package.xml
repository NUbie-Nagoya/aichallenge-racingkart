<?xml version="1.0"?>
<package format="3">
  <name>racing_maneuver_controller</name>
  <version>0.1.0</version>
  <description>Shadow-first safety-gated TorchScript racing maneuver controller.</description>
  <maintainer email="nirun.weerawit@gmail.com">NIRUNPORNPUTHA Weerawit</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>autoware_auto_control_msgs</exec_depend>
  <exec_depend>autoware_auto_vehicle_msgs</exec_depend>
  <exec_depend>v2x_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
